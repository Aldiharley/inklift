{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inklift",
  "version": "0.1.0",
  "identifier": "app.inklift.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "inklift",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Graphics",
    "shortDescription": "Lift handwriting off any image",
    "longDescription": "Extracts handwriting from a photo or screenshot onto a transparent or white background."
  }
}
