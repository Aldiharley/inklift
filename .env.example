# inklift — credentials for the optional hosted-model path
#
#   cp .env.example .env
#
# Then fill in whichever provider you want to compare against. Leave the other
# blank; an empty value is ignored rather than treated as a key.
#
# Notes:
#   - .env is gitignored. Never commit a filled-in copy.
#   - A real exported environment variable takes precedence over this file.
#   - The hosted path is opt-in. Without --via, nothing leaves your machine
#     and no key is needed at all.

# Google Gemini — Nano Banana Pro (gemini-3-pro-image)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — GPT-Image (gpt-image-2), the only one of the two with a real
# alpha channel via background=transparent.
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
